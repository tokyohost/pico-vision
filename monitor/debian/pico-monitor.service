[Unit]
Description=Pico LCD 系统硬件监控服务
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/pico-monitor --config /etc/pico-monitor/config.yaml
Restart=always
RestartSec=3
User=root
StateDirectory=pico-monitor
StateDirectoryMode=0750
Environment=HOME=/var/lib/pico-monitor
Environment=PICO_MONITOR_DATA_ROOT=/var/lib/pico-monitor
Environment=PICO_MONITOR_SCREENSHOT_DIR=/var/lib/pico-monitor/screenshot
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# 仅开放应用配置目录，允许临时文件写入与原子替换，不放开整个 /etc。
ReadWritePaths=/etc/pico-monitor

[Install]
WantedBy=multi-user.target
